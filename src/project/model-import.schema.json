{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiraStructures modellförslag v3 (läser även v1/v2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "units", "coordinates", "importId", "objects"],
  "properties": {
    "format": {
      "const": "lira-model-import"
    },
    "version": {
      "enum": [1, 2, 3]
    },
    "units": {
      "const": "mm"
    },
    "coordinates": {
      "const": "local-z-up"
    },
    "importId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/part"
      }
    }
  },
  "$defs": {
    "point3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "point2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "sourceText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "\\S"
    },
    "sweep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "source", "material", "profile", "start", "end"],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {
              "$ref": "#/$defs/sourceText"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "detail": {
              "$ref": "#/$defs/sourceText"
            },
            "elementId": {
              "$ref": "#/$defs/sourceText"
            }
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          }
        },
        "type": {
          "const": "sweep"
        },
        "material": {
          "$ref": "#/$defs/name"
        },
        "ifcClass": {
          "enum": [
            "IfcBeam",
            "IfcColumn",
            "IfcMember",
            "IfcPlate",
            "IfcSlab",
            "IfcWall",
            "IfcFooting",
            "IfcCovering",
            "IfcMechanicalFastener",
            "IfcBuildingElementProxy"
          ]
        },
        "profile": {
          "$ref": "#/$defs/name"
        },
        "start": {
          "$ref": "#/$defs/point3"
        },
        "end": {
          "$ref": "#/$defs/point3"
        },
        "rotation": {
          "type": "number"
        },
        "profileUp": {
          "$ref": "#/$defs/point3"
        }
      }
    },
    "plate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "source",
        "material",
        "frame",
        "polygon",
        "thickness",
        "side"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {
              "$ref": "#/$defs/sourceText"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "detail": {
              "$ref": "#/$defs/sourceText"
            },
            "elementId": {
              "$ref": "#/$defs/sourceText"
            }
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          }
        },
        "type": {
          "const": "plate"
        },
        "material": {
          "$ref": "#/$defs/name"
        },
        "ifcClass": {
          "enum": [
            "IfcBeam",
            "IfcColumn",
            "IfcMember",
            "IfcPlate",
            "IfcSlab",
            "IfcWall",
            "IfcFooting",
            "IfcCovering",
            "IfcMechanicalFastener",
            "IfcBuildingElementProxy"
          ]
        },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "u", "v"],
          "properties": {
            "origin": {
              "$ref": "#/$defs/point3"
            },
            "u": {
              "$ref": "#/$defs/point3"
            },
            "v": {
              "$ref": "#/$defs/point3"
            }
          }
        },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/point2"
          }
        },
        "thickness": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000
        },
        "side": {
          "enum": ["center", "positive", "negative"]
        }
      }
    },
    "fit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "source", "references", "mode", "endA", "endB", "gap"],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {
              "$ref": "#/$defs/sourceText"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "detail": {
              "$ref": "#/$defs/sourceText"
            },
            "elementId": {
              "$ref": "#/$defs/sourceText"
            }
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          }
        },
        "type": {
          "const": "fit"
        },
        "references": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "mode": {
          "enum": ["abut", "miter"]
        },
        "endA": {
          "enum": ["start", "end"]
        },
        "endB": {
          "enum": ["start", "end"]
        },
        "gap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "linecut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "source", "targets", "frame", "polygon", "side"],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {
              "$ref": "#/$defs/sourceText"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "detail": {
              "$ref": "#/$defs/sourceText"
            },
            "elementId": {
              "$ref": "#/$defs/sourceText"
            }
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          }
        },
        "type": {
          "const": "linecut"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "u", "v"],
          "properties": {
            "origin": {
              "$ref": "#/$defs/point3"
            },
            "u": {
              "$ref": "#/$defs/point3"
            },
            "v": {
              "$ref": "#/$defs/point3"
            }
          }
        },
        "polygon": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/point2"
          }
        },
        "side": {
          "enum": ["positive", "negative"]
        }
      }
    },
    "polygoncut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "source",
        "targets",
        "frame",
        "polygon",
        "thickness",
        "side"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {
              "$ref": "#/$defs/sourceText"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "detail": {
              "$ref": "#/$defs/sourceText"
            },
            "elementId": {
              "$ref": "#/$defs/sourceText"
            }
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          }
        },
        "type": {
          "const": "polygoncut"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "u", "v"],
          "properties": {
            "origin": {
              "$ref": "#/$defs/point3"
            },
            "u": {
              "$ref": "#/$defs/point3"
            },
            "v": {
              "$ref": "#/$defs/point3"
            }
          }
        },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/point2"
          }
        },
        "thickness": {
          "type": "number",
          "minimum": 1,
          "maximum": 10000
        },
        "side": {
          "enum": ["center", "positive", "negative"]
        }
      }
    },
    "part": {
      "oneOf": [
        {
          "$ref": "#/$defs/sweep"
        },
        {
          "$ref": "#/$defs/plate"
        },
        {
          "$ref": "#/$defs/fit"
        },
        {
          "$ref": "#/$defs/linecut"
        },
        {
          "$ref": "#/$defs/polygoncut"
        },
        {
          "$ref": "#/$defs/fastener"
        }
      ]
    },
    "fastener": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source",
        "type",
        "spec",
        "length",
        "start",
        "direction",
        "assembly",
        "holes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {
              "$ref": "#/$defs/sourceText"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "detail": {
              "$ref": "#/$defs/sourceText"
            },
            "elementId": {
              "$ref": "#/$defs/sourceText"
            }
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          }
        },
        "type": {
          "const": "fastener"
        },
        "spec": {
          "$ref": "#/$defs/name"
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "start": {
          "$ref": "#/$defs/point3"
        },
        "direction": {
          "$ref": "#/$defs/point3"
        },
        "assembly": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bolt", "nearWasher", "nearNut", "farWasher", "nut", "extraNut"],
          "properties": {
            "bolt": {
              "type": "boolean"
            },
            "nearWasher": {
              "type": "boolean"
            },
            "nearNut": {
              "type": "boolean"
            },
            "farWasher": {
              "type": "boolean"
            },
            "nut": {
              "type": "boolean"
            },
            "extraNut": {
              "type": "boolean"
            }
          }
        },
        "holes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "diameter", "extent"],
            "properties": {
              "target": {
                "$ref": "#/$defs/name"
              },
              "diameter": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              },
              "extent": {
                "enum": ["wall", "profile"]
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "objects": {
            "items": {
              "properties": {
                "type": {
                  "enum": ["sweep", "plate"]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "objects": {
            "items": {
              "properties": {
                "type": {
                  "enum": ["sweep", "plate", "fit", "linecut", "polygoncut"]
                }
              }
            }
          }
        }
      }
    }
  ]
}
